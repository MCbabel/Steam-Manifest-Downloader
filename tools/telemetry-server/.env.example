# Hex-encoded X25519 private key (32 bytes → 64 hex chars).
# Generate with the small keygen helper shipped in this repo or openssl/sodium.
TELEMETRY_PRIVATE_KEY_HEX=replace-me-with-64-hex-chars

# Where to append JSONL files. Created on startup if missing.
TELEMETRY_DATA_DIR=./data

# Bind address. Keep 127.0.0.1 in dev; in prod bind 0.0.0.0 and put it behind
# Caddy / nginx that terminates TLS and never forwards IP headers.
TELEMETRY_BIND=127.0.0.1:9999

# Logging.
RUST_LOG=smd_telemetry_server=info,tower_http=warn